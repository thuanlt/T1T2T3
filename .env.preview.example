# LLM_API_KEY: key FPT Smart Cloud bạn đã nhập trong Settings
# LLM_BASE_URL: Vietnam = https://mkp-api.fptcloud.com | Japan = https://mkp-api.fptcloud.jp
# LLM_CHAT_MODEL: tên model chat (xem danh sách model trên thẻ provider trong Settings)
# LLM_EMBED_MODEL: tên model embedding
LLM_API_KEY=
LLM_BASE_URL=https://mkp-api.fptcloud.com
LLM_CHAT_MODEL=fpt-genai-2
LLM_EMBED_MODEL=text-embedding-3-small

# ---- Đa model (router/judge decision) ----
# LLM_ROUTER_MODEL: model "judge decision" — chạy TRƯỚC, quyết định route (rag/image/vision/general/out_of_scope)
#                   + tín hiệu urgent/mood. FPT: "Quyet-1.0-Large" (gọi qua /v1/systemone).
#                   Để trống -> dùng LLM_CHAT_MODEL làm router (chat completions JSON).
LLM_ROUTER_MODEL=Quyet-1.0-Large
LLM_IMAGE_MODEL=
LLM_VISION_MODEL=Qwen2.5-VL-7B-Instruct

# LLM_VERIFY_SSL=false khi chạy sau proxy có cert tự ký (môi trường preview VibeFlow)
LLM_VERIFY_SSL=false